<Window x:Class="RawInspector.GeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パターンを生成" Height="760" Width="1180" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">

  <!-- ApplicationCommands.Help は F1 を最初から持っているので、キーの割り当ては書きません。 -->
  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="OnHelpExecuted" />
  </Window.CommandBindings>

  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="FieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,10,6" />
      <Setter Property="MinWidth" Value="110" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,10,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4,3" />
    </Style>

    <!-- ▲▼ と ＋－。数の欄の隣に置くので、文字の高さ2つぶんに収めます。 -->
    <Style TargetType="Button" x:Key="SpinButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="11" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="12">

    <!-- 生成器へ繋がっていないと何も選べないので、いちばん上に出します。 -->
    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,8" CornerRadius="4"
            Background="#FFFFF4E5" BorderBrush="#FFE0B77A" BorderThickness="1"
            Visibility="{Binding HasCatalogError, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="生成器へ接続できていません" FontWeight="SemiBold" Foreground="#FF7A4E00" />
        <TextBlock Text="{Binding CatalogError}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="#FF7A4E00" FontFamily="{StaticResource MonoFont}" FontSize="11" />
      </StackPanel>
    </Border>

    <!-- 下部: 実行するコマンドと結果 -->
    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
            Background="{StaticResource GroupFill}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
          <!-- 成立しない組み合わせの読み方と、選択肢がどこから来るかはここに書いてあります。 -->
          <Button Content="？" Width="34" MinWidth="34" Margin="0,0,6,0" Command="Help"
                  ToolTip="この窓の使い方を開きます（F1）。" />
          <Button Content="コマンドをコピー" Command="{Binding CopyCommandCommand}" Margin="0,0,6,0"
                  ToolTip="このまま端末へ貼って実行できます。" />
          <Button Content="生成" Command="{Binding GenerateCommand}" MinWidth="80" Margin="0"
                  ToolTip="生成器を実行します。できたRAWは一覧へ取り込んで選択します。" />
        </StackPanel>
        <StackPanel>
          <!-- 何が実行されるのかを隠しません。中を見せておくほうが、あとから追えます。 -->
          <TextBlock Text="実行するコマンド" Foreground="{StaticResource MutedText}" FontSize="11" />
          <TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2,0,0"
                   Background="White" MaxHeight="60" VerticalScrollBarVisibility="Auto" />
          <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" />
          <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,4,0,0"
                   Background="White" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                   Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 左が条件、右が参考図。テスト信号発生器の説明書と同じで、
         「どんな形の絵か」と「何を見るためのものか」を並べて置きます。
         押してから絵を見るのでは、条件を決める助けになりません。 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Text="何を描くか" Style="{StaticResource SectionHeader}" />
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="パターン" Style="{StaticResource FieldLabel}" />
          <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Patterns}" SelectedItem="{Binding Pattern}"
                    IsEditable="False" ToolTip="生成する絵です。何を見るための絵かは、本体側の説明欄に出ます。" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="サイズ" Style="{StaticResource FieldLabel}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            <TextBlock Text="x" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
            <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            <!-- 通称のある大きさは選べるようにします。打ち込みだと、4K のつもりで
                 桁を1つ落としても、生成器は素直にその大きさで作ってしまいます。 -->
            <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SizePreset}"
                      Width="170" Margin="0,0,0,6"
                      ToolTip="よく使う大きさから選べます。表に無い大きさは左の欄へ直接打ち込んでください。" />
          </StackPanel>
        </Grid>

        <TextBlock Text="どう格納するか" Style="{StaticResource SectionHeader}" />
        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="色モデル" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding ColorModels}" SelectedItem="{Binding ColorModel}" MinWidth="90" />
          <TextBlock Text="色差" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Subsamplings}" SelectedItem="{Binding Subsampling}" MinWidth="80" />
          <TextBlock Text="ビット深度" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" MinWidth="70" />
          <TextBlock Text="格納形式" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Storages}" SelectedItem="{Binding Storage}" MinWidth="90" />
        </WrapPanel>
        <WrapPanel Margin="0,0,0,10">
          <TextBlock Text="range" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" MinWidth="90" />
          <TextBlock Text="matrix" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Matrices}" SelectedItem="{Binding Matrix}" MinWidth="90" />
          <TextBlock Text="10bitの詰め" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Alignment}" MinWidth="70"
                    ToolTip="16bitコンテナへ10bitを入れるときの寄せ方です。8bitでは使いません。" />
        </WrapPanel>

        <!-- 成立しない理由はここに出します。選択肢を黙って消すと、なぜ消えたのか分かりません。 -->
        <Border Padding="10,8" CornerRadius="4" Margin="0,0,0,10"
                Background="#FFFDECEA" BorderBrush="#FFE7A9A2" BorderThickness="1"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="#FF8A2A20" />
        </Border>
        <TextBlock Text="{Binding SizeNote}" Foreground="{StaticResource MutedText}" Margin="0,0,0,10"
                   TextWrapping="Wrap" />

        <!-- パターンごとのつまみ。並びも説明も生成器から来ます（この画面に表はありません）。 -->
        <DockPanel Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Content="既定へ戻す" Click="OnResetPatternOptions"
                  Padding="8,2" VerticalAlignment="Bottom" Margin="8,0,0,4"
                  Visibility="{Binding HasPatternOptions, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="触った設定をすべて空に戻します。" />
          <TextBlock Text="このパターンの設定" Style="{StaticResource SectionHeader}" />
        </DockPanel>

        <TextBlock Text="{Binding PatternOptionNote}" Foreground="{StaticResource MutedText}" FontSize="11"
                   Margin="0,0,0,10" TextWrapping="Wrap"
                   Visibility="{Binding HasPatternOptions, Converter={StaticResource InverseBoolToVisibility}}" />

        <StackPanel Visibility="{Binding HasPatternOptions, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="空欄は「触っていない」という意味です。触った項目だけがコマンドに載ります。"
                     Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{Binding PatternOptionRows}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="3"
                        Background="{StaticResource GroupFill}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,1,8,0">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedText}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="10" />
                    </StackPanel>

                    <!-- 数値ひとつ。よく使う値は選べて、打ち込みもできて、▲▼で1段ずつ動かせます。
                         数を入れる欄なので、幅は数の分だけにします。 -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2"
                                Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                      <ComboBox IsEditable="True" Width="96" Margin="0"
                                ItemsSource="{Binding Presets}"
                                Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="{StaticResource MonoFont}"
                                ToolTip="よく使う値から選べます。直接打ち込むこともできます。空にすると既定へ戻ります。" />
                      <StackPanel Margin="4,0,0,0">
                        <Button Content="▲" Style="{StaticResource SpinButton}" Command="{Binding StepUpCommand}" />
                        <Button Content="▼" Style="{StaticResource SpinButton}" Command="{Binding StepDownCommand}" />
                      </StackPanel>
                    </StackPanel>

                    <!-- 並び。区切り文字を打たせず、1つずつの欄に分けます。 -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,2"
                                Visibility="{Binding HasParts, Converter={StaticResource BoolToVisibility}}">
                      <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Parts}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,4,4">
                                <TextBlock Text="{Binding Label}" FontSize="9" TextAlignment="Center"
                                           Foreground="{StaticResource MutedText}" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Width="52" Margin="0" TextAlignment="Center"
                                         FontFamily="{StaticResource MonoFont}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 個数が決まっていない並びだけ、増やしたり減らしたりできます。 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,0,0,4"
                                    Visibility="{Binding IsVariableLength, Converter={StaticResource BoolToVisibility}}">
                          <Button Content="－" Style="{StaticResource SpinButton}" Width="22" Height="22"
                                  Command="{Binding RemovePartCommand}" ToolTip="欄を1つ減らします。" />
                          <Button Content="＋" Style="{StaticResource SpinButton}" Width="22" Height="22" Margin="2,0,0,0"
                                  Command="{Binding AddPartCommand}" ToolTip="欄を1つ増やします。" />
                        </StackPanel>
                      </StackPanel>

                      <Button Content="既定を入れる" Command="{Binding FillDefaultCommand}"
                              HorizontalAlignment="Left" Padding="6,1" MinWidth="0" Margin="0,0,0,2" FontSize="11"
                              ToolTip="既定の並びを欄へ入れます。そこから直したいところだけ動かせます。全部そのままならコマンドには載りません。" />
                    </StackPanel>

                    <!-- 選択肢 -->
                    <ComboBox Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" MinWidth="150"
                              ItemsSource="{Binding ChoiceItems}" SelectedItem="{Binding Choice}" Margin="0,0,0,2"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 入り切り -->
                    <CheckBox Grid.Column="1" Grid.Row="0" IsChecked="{Binding Flag}" Content="{Binding Label}"
                              VerticalAlignment="Center" Margin="0,2,0,4"
                              Visibility="{Binding IsFlag, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Hint}"
                               Foreground="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />

                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding Help}" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />

                    <!-- 打ち込んだ値がおかしいとき。最後に判定するのは生成器ですが、
                         ここで先に言えるものは先に言います。 -->
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Problem}" Margin="0,0,0,0"
                               Foreground="#FFB3261E" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="どこへ出すか" Style="{StaticResource SectionHeader}" />
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="フォルダ" Style="{StaticResource FieldLabel}" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Row="0" Grid.Column="2" Content="選ぶ…" Click="OnPickFolder" Margin="0,0,0,6" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="ファイル名" Style="{StaticResource FieldLabel}" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="空にすると条件から名前を作ります。拡張子は生成器が付けます（.raw / .preview.png / .manifest.json）。" />
        </Grid>

        <TextBlock Text="生成器の呼び出し方" Style="{StaticResource SectionHeader}" />
        <TextBlock Text="画素を作る処理はPython側の生成器にあります。ここはその呼び出しだけです。"
                   Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="接続し直す" Click="OnReconnect" Margin="6,0,0,0" />
          <TextBox Text="{Binding GeneratorCommand, UpdateSourceTrigger=LostFocus}"
                   FontFamily="{StaticResource MonoFont}" Margin="0" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 右: 参考図と、このパターンが何のためのものか。 -->
    <ScrollViewer Grid.Column="1" Width="500" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Text="どんな絵になるか" Style="{StaticResource SectionHeader}" />

        <!-- 図。背景を暗くしているのは、白地のパターン（frame や hatch）で
             絵の端がどこまでかを見えるようにするためです。 -->
        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                Background="#FF2C2E33" MinHeight="120">
          <Grid>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxWidth="480"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="このパターンの参考図は入っていません"
                       Foreground="#FFB0B6C0" FontSize="11" Margin="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
        </Border>

        <!-- いま何を見ているのかは、必ず絵の下に1行で言い切ります。
             参考図と実物の区別が付かないまま条件を決められるほうが困ります。 -->
        <TextBlock Text="{Binding PreviewNote}" Foreground="{StaticResource MutedText}"
                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

        <Button Content="この条件で描いてみる" Command="{Binding PreviewCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0"
                ToolTip="いまの条件のまま、絵だけを一時フォルダへ描かせて差し替えます。RAWは書きません。参考図と条件が同じあいだは押せません。" />

        <TextBlock Text="細かい線・折り返し・ドットバイドットは、この大きさでは出ません。生成してから等倍（Ctrl+0）で見てください。"
                   Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />

        <TextBlock Text="何を見るためのものか" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
        <TextBlock Text="{Binding Guide.Purpose}" TextWrapping="Wrap" />

        <TextBlock Text="どう読むか" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
        <TextBlock Text="{Binding Guide.HowToRead}" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedText}" />
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
