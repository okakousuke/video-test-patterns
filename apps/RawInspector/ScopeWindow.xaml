<Window x:Class="RawInspector.ScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分布を見る（ヒストグラム・波形・ベクトル）" Icon="app.ico"
        Height="820" Width="760" MinHeight="480" MinWidth="600"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterOwner">

  <!-- ApplicationCommands.Help は F1 を最初から持っているので、キーの割り当ては書きません。 -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </Window.InputBindings>

  <Window.CommandBindings>
    <CommandBinding Command="Help" Executed="OnHelpExecuted" />
  </Window.CommandBindings>

  <DockPanel Margin="10">

    <!-- 上: 何をどの条件で数えたか。
         分布そのものより先に、これが目に入る位置でないといけません。
         別のRAWの数字を、いま見ているRAWのものだと読むのがいちばん危ないためです。 -->
    <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="4" Margin="0,0,0,8"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="？" Width="34" MinWidth="34" Margin="6,0,0,0"
                Command="Help" ToolTip="この窓の使い方を開きます（F1）。" />
        <Button DockPanel.Dock="Right" Content="⟳ 取り直す" Margin="0"
                Command="{Binding RefreshCommand}"
                ToolTip="いま本体で見ているRAWと表示条件で数え直します（F5）。" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedText}" FontSize="11"
                     Margin="0,2,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MeasuredUnder}" Foreground="{StaticResource MutedText}" FontSize="11"
                     Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 古くなった数字を出しているあいだの警告。自動では数え直しません。 -->
    <Border DockPanel.Dock="Top" Padding="10,6" CornerRadius="4" Margin="0,0,0,8"
            Background="#FFFFF4E5" BorderBrush="#FFE0B77A" BorderThickness="1"
            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding StaleWarning}" TextWrapping="Wrap" Foreground="#FF7A4E00" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ヒストグラム -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="ヒストグラム（コード値の分布）" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedText}"
                   Margin="0,0,0,6"
                   Text="横がコード値、縦がその値を持つ画素の数です。表示用の8bitではなく、RAWのコード値のまま数えています。細い縦線は規定の範囲（limited のときの 16 と 235／240）の境目です。" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <CheckBox Content="縦を対数にする" IsChecked="{Binding LogScale, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip="テストパターンは一様な面を持つものが多く、そこだけ何万画素も積み上がります。線形の目盛りだと、その山以外は床に貼り付いて見えません。「1画素だけ違う値がある」を見つけるために、既定は対数です。" />
        </StackPanel>

        <TextBlock Text="{Binding FirstLabel}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,2" />
        <Image Source="{Binding FirstHistogram}" Height="120" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,8" />
        <TextBlock Text="{Binding SecondLabel}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,2" />
        <Image Source="{Binding SecondHistogram}" Height="120" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,8" />
        <TextBlock Text="{Binding ThirdLabel}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,2" />
        <Image Source="{Binding ThirdHistogram}" Height="120" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,14" />

        <!-- 波形 -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="波形（横位置ごとの分布）" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="成分" VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{StaticResource MutedText}" />
          <ComboBox ItemsSource="{Binding WaveformChannels}" SelectedItem="{Binding WaveformChannel}"
                    DisplayMemberPath="Label" Width="80" VerticalAlignment="Center"
                    ToolTip="どの成分の波形を出すかです。選び直すと数え直します。" />
        </StackPanel>
        <TextBlock Text="{Binding WaveformNote}" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource MutedText}" Margin="0,0,0,6" />
        <Image Source="{Binding Waveform}" Height="256" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,14" />

        <!-- ベクトル -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="ベクトル（Cb-Cr 平面）" />
        <TextBlock Text="{Binding VectorNote}" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource MutedText}" Margin="0,0,0,6"
                   Visibility="{Binding HasVector, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding VectorUnavailable}" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource MutedText}" Margin="0,0,0,6"
                   Visibility="{Binding HasVector, Converter={StaticResource InverseBoolToVisibility}}" />
        <Image Source="{Binding Vector}" Width="256" Height="256" Stretch="Fill"
               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor"
               Margin="0,0,0,14"
               Visibility="{Binding HasVector, Converter={StaticResource BoolToVisibility}}" />

        <!-- 数値 -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="数値" />
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowBackground="White" Margin="0,0,0,8"
                  CanUserSortColumns="False" HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTextColumn Header="成分" Binding="{Binding Label}" Width="70" />
            <DataGridTextColumn Header="値の幅" Binding="{Binding Range}" Width="110" />
            <DataGridTextColumn Header="平均" Binding="{Binding Mean}" Width="80" />
            <DataGridTextColumn Header="値の種類" Binding="{Binding Distinct}" Width="90" />
            <DataGridTextColumn Header="規定の範囲" Binding="{Binding Nominal}" Width="110" />
            <DataGridTextColumn Header="規定外の画素" Binding="{Binding Outside}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Padding="10,8" CornerRadius="4" Background="#FFF7F4EE"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <TextBlock Text="{Binding ClipNote}" TextWrapping="Wrap" />
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
