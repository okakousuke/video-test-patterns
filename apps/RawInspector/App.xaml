<Application x:Class="RawInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RawInspector"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <SolidColorBrush x:Key="PanelBackground" Color="#FFF7F8FA" />
    <!-- 窓が2つになったので、両方で使うものはここへ置きます。
         MainWindow の中に置くと、生成窓から参照できません。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF4F6F9" />

    <SolidColorBrush x:Key="PanelBorder" Color="#FFD0D5DC" />
    <SolidColorBrush x:Key="AccentText" Color="#FF005CB4" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#FFE8F2FE" />
    <SolidColorBrush x:Key="MutedText" Color="#FF5A6270" />

    <!-- 役割ごとの色。増やすほど「どれが主要な操作か」が読めなくなるので、
         役割が違うものだけに付けます。
           Accent       … その画面で最初にやること（フォルダを開く）
           Generate     … 生成の実行。濃い原色で、ここだけ別格にします
           Save         … 何かを書き出す操作
           ToolAction   … 道具帯で押すとその場で効くボタン（等倍・全体表示）
           Analysis     … 数え直して別の窓を開く操作（分布・比較）
           PreviewStale … 押さないと絵が古いまま、という報せ
           それ以外     … 色を付けない -->
    <SolidColorBrush x:Key="AccentFill" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF115EA3" />
    <SolidColorBrush x:Key="GenerateFill" Color="#FF107C10" />
    <SolidColorBrush x:Key="GenerateFillHover" Color="#FF0B5A0B" />
    <SolidColorBrush x:Key="SaveFill" Color="#FFEAF3E8" />
    <SolidColorBrush x:Key="SaveFillHover" Color="#FFDCEBD8" />
    <SolidColorBrush x:Key="SaveBorder" Color="#FFA8C9A0" />
    <SolidColorBrush x:Key="GroupFill" Color="#FFFBFCFD" />
    <SolidColorBrush x:Key="RowHeaderFill" Color="#FFEBEFF5" />
    <!-- 別の窓が開く操作（分布・比較）。橙は他のどれとも重なりません。 -->
    <SolidColorBrush x:Key="AnalysisFill" Color="#FFFFF8F0" />
    <SolidColorBrush x:Key="AnalysisBorder" Color="#FFEDBC86" />
    <SolidColorBrush x:Key="AnalysisFillHover" Color="#FFFFEFDE" />

    <!-- 道具帯の中で、押すとその場で効くボタン（等倍・全体表示）。
         同じ帯に並ぶ切り替え（ToolToggle）は白なので、押しボタンだけ桃色にして
         「状態」と「操作」を色で分けます。 -->
    <SolidColorBrush x:Key="ToolActionFill" Color="#FFFEF6FA" />
    <SolidColorBrush x:Key="ToolActionBorder" Color="#FFEAAEC6" />
    <SolidColorBrush x:Key="ToolActionFillHover" Color="#FFFDEDF4" />

    <!-- 絵が古いことの報せ。目の端でも気付く程度に、はっきりした黄にします。 -->
    <SolidColorBrush x:Key="PreviewStaleFill" Color="#FFFFEFA6" />
    <SolidColorBrush x:Key="PreviewStaleBorder" Color="#FFD8A81C" />

    <!-- 数値の桁を揃えたい箇所（コード値、座標、バイト数）で使います。 -->
    <FontFamily x:Key="MonoFont">Consolas, MS Gothic</FontFamily>

    <Style TargetType="TextBlock" x:Key="SectionHeader">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <!-- 既定のボタン。角丸と控えめな枠だけにして、色は付けません。 -->
    <Style TargetType="Button" x:Key="FlatButton">
      <!-- 灰色のボタンほど説明が要ります。既定では無効なコントロールに説明は出ないので、
           「押せないのはなぜか」を確かめる手立てが無くなります。 -->
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF1F2430" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFEFF3F8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFE2E8F0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

    <!-- 最初にやること用。画面で1つだけにします。 -->
    <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource AccentFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentFill}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentFillHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFB8C4D2" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB8C4D2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 生成の実行。この窓でいちばん重い操作（実際にRAWが出ます）なので、
         ほかの淡い色とは別格の、濃い原色にします。 -->
    <Style TargetType="Button" x:Key="GenerateButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource GenerateFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource GenerateFill}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GenerateFillHover}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GenerateFillHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFB8C4D2" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB8C4D2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 書き出す操作用。淡い色で「同じ仲間」だと分かる程度にします。 -->
    <Style TargetType="Button" x:Key="SaveButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource SaveFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource SaveBorder}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SaveFillHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- RAWのコピーは変換も圧縮も通しません。圧縮画像の保存と同じ色にすると
         同じ仲間に見えてしまうため、意図的に別の色にします。 -->
    <Style TargetType="Button" x:Key="RawButton" BasedOn="{StaticResource SaveButton}">
      <Setter Property="Background" Value="#FFF6F1E6" />
      <Setter Property="BorderBrush" Value="#FFD3C4A4" />
    </Style>

    <!-- 数値解析を開く操作。押すと別の窓が出ます。橙はこの仲間だけに使います。 -->
    <Style TargetType="Button" x:Key="AnalysisButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource AnalysisFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource AnalysisBorder}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AnalysisFillHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFFBE3CB" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 道具帯の押しボタン（等倍・全体表示）。
         この帯は切り替え（ToolToggle）が主で、押していないあいだは白い枠だけです。
         同じ見た目の押しボタンを混ぜると、どちらが「いまの状態」なのか読めません。
         桃色にして、押した瞬間に効くものだと分かるようにします。 -->
    <Style TargetType="Button" x:Key="ToolActionButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource ToolActionFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ToolActionBorder}" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolActionFillHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF9DCE8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 小さなトグルの見た目。
         RadioButton は ToggleButton から派生しているので、基底の ToggleButton を対象にすれば
         排他（RadioButton）にも、組み合わせ（ToggleButton）にも同じ見た目で使えます。
         押せないときは薄くして、押しても効かないことが分かるようにします。 -->
    <Style TargetType="ToggleButton" x:Key="ToolToggle">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFEFF3F8" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BadgeBackground}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentFill}" />
                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 関連する操作をひとまとめに見せる枠 -->
    <Style TargetType="Border" x:Key="ToolGroup">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{StaticResource GroupFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

  </Application.Resources>
</Application>
