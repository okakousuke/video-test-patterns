<Application x:Class="RawInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RawInspector"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <SolidColorBrush x:Key="PanelBackground" Color="#FFF7F8FA" />
    <!-- 窓が2つになったので、両方で使うものはここへ置きます。
         MainWindow の中に置くと、生成窓から参照できません。 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF4F6F9" />

    <SolidColorBrush x:Key="PanelBorder" Color="#FFD0D5DC" />
    <SolidColorBrush x:Key="AccentText" Color="#FF005CB4" />
    <SolidColorBrush x:Key="BadgeBackground" Color="#FFE8F2FE" />
    <SolidColorBrush x:Key="MutedText" Color="#FF5A6270" />

    <!-- 役割ごとの色。使うのは3系統だけに絞ります。
         色が増えるほど「どれが主要な操作か」が読めなくなるためです。
           Accent  … その画面で最初にやること（フォルダを開く）
           Save    … 何かを書き出す操作
           それ以外 … 色を付けない -->
    <SolidColorBrush x:Key="AccentFill" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="AccentFillHover" Color="#FF115EA3" />
    <SolidColorBrush x:Key="SaveFill" Color="#FFEAF3E8" />
    <SolidColorBrush x:Key="SaveFillHover" Color="#FFDCEBD8" />
    <SolidColorBrush x:Key="SaveBorder" Color="#FFA8C9A0" />
    <SolidColorBrush x:Key="GroupFill" Color="#FFFBFCFD" />
    <SolidColorBrush x:Key="RowHeaderFill" Color="#FFEBEFF5" />

    <!-- 数値の桁を揃えたい箇所（コード値、座標、バイト数）で使います。 -->
    <FontFamily x:Key="MonoFont">Consolas, MS Gothic</FontFamily>

    <Style TargetType="TextBlock" x:Key="SectionHeader">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <!-- 既定のボタン。角丸と控えめな枠だけにして、色は付けません。 -->
    <Style TargetType="Button" x:Key="FlatButton">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF1F2430" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFEFF3F8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFE2E8F0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

    <!-- 最初にやること用。画面で1つだけにします。 -->
    <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource AccentFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentFill}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentFillHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFB8C4D2" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB8C4D2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 書き出す操作用。淡い色で「同じ仲間」だと分かる程度にします。 -->
    <Style TargetType="Button" x:Key="SaveButton" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Background" Value="{StaticResource SaveFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource SaveBorder}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SaveFillHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FFF4F5F7" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="Foreground" Value="#FFAAB0BA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- RAWのコピーは変換も圧縮も通しません。圧縮画像の保存と同じ色にすると
         同じ仲間に見えてしまうため、意図的に別の色にします。 -->
    <Style TargetType="Button" x:Key="RawButton" BasedOn="{StaticResource SaveButton}">
      <Setter Property="Background" Value="#FFF6F1E6" />
      <Setter Property="BorderBrush" Value="#FFD3C4A4" />
    </Style>

    <!-- 小さなトグルの見た目。
         RadioButton は ToggleButton から派生しているので、基底の ToggleButton を対象にすれば
         排他（RadioButton）にも、組み合わせ（ToggleButton）にも同じ見た目で使えます。
         押せないときは薄くして、押しても効かないことが分かるようにします。 -->
    <Style TargetType="ToggleButton" x:Key="ToolToggle">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" CornerRadius="4" Background="White"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFEFF3F8" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BadgeBackground}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentFill}" />
                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 関連する操作をひとまとめに見せる枠 -->
    <Style TargetType="Border" x:Key="ToolGroup">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{StaticResource GroupFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

  </Application.Resources>
</Application>
