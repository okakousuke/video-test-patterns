<Window x:Class="RawInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RawInspector.ViewModels"
        xmlns:local="clr-namespace:RawInspector"
        Title="RAW Inspector" Icon="app.ico"
        Height="860" Width="1560" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BoolToHiddenConverter x:Key="BoolToHidden" />

    <!-- プレビュー背景の市松模様。画像の外側だと分かればよいので、コントラストは低くします。
         はっきり描くと、見たいパターンより背景のほうが目立ってしまいます。 -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF2C2E33">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,24,24" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FF313339">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="0,0,12,12" />
                <RectangleGeometry Rect="12,12,12,12" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>

  <!-- 拡大縮小はボタンからもキーからも同じ経路（中央を保つ）を通します。 -->
  <Window.CommandBindings>
    <CommandBinding Command="NavigationCommands.IncreaseZoom" Executed="OnZoomInExecuted" />
    <CommandBinding Command="NavigationCommands.DecreaseZoom" Executed="OnZoomOutExecuted" />
  </Window.CommandBindings>

  <Window.InputBindings>
    <KeyBinding Modifiers="Control" Key="D1" Command="{Binding SaveImageCommand}" CommandParameter="png" />
    <KeyBinding Modifiers="Control" Key="D2" Command="{Binding SaveImageCommand}" CommandParameter="jpg" />
    <KeyBinding Modifiers="Control" Key="D3" Command="{Binding SaveImageCommand}" CommandParameter="tiff" />
    <KeyBinding Modifiers="Control" Key="D4" Command="{Binding SaveImageCommand}" CommandParameter="bmp" />
    <KeyBinding Modifiers="Control" Key="D5" Command="{Binding SaveImageCommand}" CommandParameter="gif" />
    <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ActualSizeCommand}" />
    <KeyBinding Modifiers="Control" Key="OemPlus" Command="NavigationCommands.IncreaseZoom" />
    <KeyBinding Modifiers="Control" Key="Add" Command="NavigationCommands.IncreaseZoom" />
    <KeyBinding Modifiers="Control" Key="OemMinus" Command="NavigationCommands.DecreaseZoom" />
    <KeyBinding Modifiers="Control" Key="Subtract" Command="NavigationCommands.DecreaseZoom" />
  </Window.InputBindings>

  <DockPanel>

    <!-- 上段: フォルダ操作。開くのは左端、出力先は右端へ寄せます。 -->
    <Border DockPanel.Dock="Top" Padding="8" Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="📁 フォルダを開く" Style="{StaticResource AccentButton}"
                Command="{Binding OpenFolderCommand}"
                ToolTip="manifestとRAWのあるフォルダを開きます（Ctrl+O）。サブフォルダも走査します。" />

        <!-- 書き出しはすべてここへ集めます。保存先の指定と保存の操作が離れていると、
             どこへ出るのか分からないまま押すことになります。 -->
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0" MaxWidth="460"
                   Text="{Binding OutputFolderText}" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource AccentText}" Cursor="Hand"
                   ToolTip="クリックするとエクスプローラーで開きます。">
          <TextBlock.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenOutputFolderCommand}" />
          </TextBlock.InputBindings>
        </TextBlock>

        <Button DockPanel.Dock="Right" Content="出力先..." Margin="8,0,0,0"
                Command="{Binding SelectOutputFolderCommand}"
                ToolTip="画像とRAWの保存先フォルダを変更します。" />

        <Border DockPanel.Dock="Right" Style="{StaticResource ToolGroup}" Margin="0">
          <StackPanel Orientation="Horizontal">
            <!-- いちばん長い項目（PNG（可逆・既定））が、右端の矢印にかからない幅にします。 -->
            <ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedImageFormat}"
                      Width="164" Margin="0,0,6,0" VerticalAlignment="Center"
                      ToolTip="保存する圧縮画像の形式です。" />
            <Button Content="保存..." Style="{StaticResource SaveButton}"
                    Command="{Binding SaveSelectedFormatCommand}"
                    ToolTip="選んだ形式で、保存先とファイル名を指定して保存します（Ctrl+1〜Ctrl+5で形式を直接指定）。" />
            <Button Content="全形式" Style="{StaticResource SaveButton}"
                    Command="{Binding SaveAllFormatsCommand}"
                    ToolTip="PNG・JPEG・TIFF・BMP・GIF をまとめて出力先フォルダへ保存します。形式ごとの見え方を並べて比べるとき用です。" />
            <Button Content="💾 RAWコピー" Style="{StaticResource RawButton}" Margin="0"
                    Command="{Binding SaveRawCopyCommand}"
                    ToolTip="選択中のRAWファイルを、変換も圧縮もせずそのまま保存します。左の圧縮画像とは別物です。" />
          </StackPanel>
        </Border>

        <TextBlock VerticalAlignment="Center" Margin="4,0,16,0"
                   Text="{Binding FolderText}" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding FolderText}" />
      </DockPanel>
    </Border>

    <!-- 下段: ピクセルプローブとステータス。
         高さを固定し、各欄も固定幅の列に載せます。カーソルを動かすたびに文字数が変わるため、
         成り行きの幅にすると桁位置や高さが動き、上のプレビュー枠までずれます。
         プレビュー欄の下ではなくウィンドウ全幅に置いているのは、
         中央パネルを狭めても欄が入りきるようにするためです。 -->
    <Border DockPanel.Dock="Bottom" Padding="8,0" Height="40"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0"
            ToolTip="コード値はRAWから読んだ生の値です（10bitなら0-1023のまま）。変換後はmatrixとrangeを適用して8bitへ丸めた値です。">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="84" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="210" />
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="80" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 色見本。カーソルが外れても枠は残します（消すと幅が詰まって全体がずれるため）。 -->
        <Border Grid.Column="0" Width="22" Height="22" Margin="0,0,10,0"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                Background="{Binding HoverSwatch}" />

        <TextBlock Grid.Column="1" Text="座標" VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{StaticResource MutedText}" />
        <TextBlock Grid.Column="2" Text="{Binding HoverPositionText}" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />

        <Rectangle Grid.Column="3" Width="1" Height="20" Margin="6,0,10,0"
                   Fill="{StaticResource PanelBorder}" />

        <TextBlock Grid.Column="4" Text="コード値" VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{StaticResource MutedText}" />
        <TextBlock Grid.Column="5" Text="{Binding HoverCodeText}" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="6" Text="{Binding HoverCodeRangeText}" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedText}" />

        <Rectangle Grid.Column="7" Width="1" Height="20" Margin="6,0,10,0"
                   Fill="{StaticResource PanelBorder}" />

        <TextBlock Grid.Column="8" Text="変換後" VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{StaticResource MutedText}" />
        <TextBlock Grid.Column="9" Text="{Binding HoverHexText}" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" />
        <TextBlock Grid.Column="10" Text="{Binding HoverRgbText}" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedText}"
                   TextTrimming="CharacterEllipsis" />

        <Rectangle Grid.Column="11" Width="1" Height="20" Margin="6,0,10,0"
                   Fill="{StaticResource PanelBorder}" />

        <TextBlock Grid.Column="12" Text="{Binding StatusText}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                   Foreground="{StaticResource MutedText}" />

        <!-- どのRAWでも変わらない注意なので、ここに出しっぱなしにします。 -->
        <TextBlock Grid.Column="13" Text="{Binding BitDepthNote}" VerticalAlignment="Center"
                   Margin="16,0,0,0" TextAlignment="Right" Foreground="{StaticResource MutedText}"
                   ToolTip="RAWのビット深度に関わらず、画面表示は8bitへ丸めています。" />
      </Grid>
    </Border>

    <!-- 本体: 一覧 / プレビュー / 生成条件 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="380" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- 左: manifest一覧 -->
      <DockPanel Grid.Column="0" Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}" Margin="0"
                     Text="manifest一覧" VerticalAlignment="Center" />
          <!-- パターンが増えると縦に伸びるので、まとめて開閉できるようにします。 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="⊟" Width="28" MinWidth="28" Padding="0,2" FontSize="14"
                    Command="{Binding CollapseAllCommand}"
                    ToolTip="すべて閉じる（パターン名の見出しだけにします）" />
            <Button Content="⊞" Width="28" MinWidth="28" Padding="0,2" FontSize="14" Margin="0"
                    Command="{Binding ExpandAllCommand}"
                    ToolTip="すべて展開する" />
          </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="色モデル" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Grid.Column="1" Margin="0,0,8,0"
                    ItemsSource="{Binding ColorModelFilters}" SelectedItem="{Binding ColorModelFilter}"
                    ToolTip="RGB系かY'CbCr系かで一覧を絞り込みます。" />
          <TextBlock Grid.Column="2" Text="サイズ" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox Grid.Column="3" Margin="0,0,6,0"
                    ItemsSource="{Binding SizeFilters}" SelectedItem="{Binding SizeFilter}"
                    ToolTip="画像サイズで一覧を絞り込みます。先頭に「〜HD」「〜FHD」「〜4K」の粗い区分があり、その下に実サイズが並びます。" />
          <!-- 絞ったまま「件数が合わない」と悩まないよう、戻す手段を隣に置きます。 -->
          <Button Grid.Column="4" Content="解除" Width="46" MinWidth="46" Margin="0"
                  Command="{Binding ResetFiltersCommand}"
                  ToolTip="絞り込みを解除して、すべて表示に戻します。" />
        </Grid>

        <!-- 選択中のパターンが何のための絵かを出します。
             形だけ見ても目的は分からないので、見るべき場所まで書いておきます。 -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,14" Padding="10,8" Height="200"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding PatternBadge}" FontWeight="Bold" Margin="0,0,0,6"
                         Foreground="{StaticResource AccentText}" TextTrimming="CharacterEllipsis" />

              <TextBlock Text="何を見るためのパターンか" FontWeight="Bold" Margin="0,0,0,2" />
              <TextBlock Text="{Binding PatternGuide.Purpose}" TextWrapping="Wrap" Margin="0,0,0,8" />

              <TextBlock Text="どこを見るか" FontWeight="Bold" Margin="0,0,0,2" />
              <TextBlock Text="{Binding PatternGuide.HowToRead}" TextWrapping="Wrap" Margin="0,0,0,8" />

              <TextBlock Text="パターン固有の指定" FontWeight="Bold" Margin="0,0,0,2" />
              <TextBlock Text="{Binding PatternGuide.Options}" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedText}" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <TreeView x:Name="ManifestTree" ItemsSource="{Binding Groups}"
                  SelectedItemChanged="OnManifestSelected"
                  VirtualizingStackPanel.IsVirtualizing="True">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.Resources>
            <!-- 既定のままだと、選択したときにシステムの反転色（白文字）になり、
                 明るい選択背景の上で文字が読めなくなります。自前の配色を使います。 -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFCFE4FA" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF11223A" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFE3ECF6" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF11223A" />
            <HierarchicalDataTemplate DataType="{x:Type vm:PatternGroupViewModel}" ItemsSource="{Binding Entries}">
              <TextBlock Text="{Binding Header}" FontWeight="Bold" />
            </HierarchicalDataTemplate>
            <DataTemplate DataType="{x:Type vm:ManifestEntryViewModel}">
              <TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                        <Setter Property="Foreground" Value="#FFB00020" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </TreeView.Resources>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource PanelBorder}" />

      <!-- 中央: プレビュー -->
      <DockPanel Grid.Column="2" Margin="8">

        <Border DockPanel.Dock="Top" Background="{StaticResource BadgeBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,0,4">
          <TextBlock Text="{Binding PatternBadge}" FontWeight="Bold" Foreground="{StaticResource AccentText}" />
        </Border>

        <!-- RAWに記録されている条件。項目名と値で色を分けます。
             下に出る絵は変換後なので、こちらが「データそのものの条件」だと分かるよう見出しを付けます。 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="8,4" CornerRadius="4"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <DockPanel>
            <Border DockPanel.Dock="Left" Background="{StaticResource AccentFill}" CornerRadius="3"
                    Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Text="RAWの条件" Foreground="White" FontWeight="Bold" FontSize="11" />
            </Border>
            <ItemsControl ItemsSource="{Binding RawSummary}"
                          ToolTip="RAWに記録されている生成条件です。画面に出ている絵の見た目ではなく、データそのものの条件です。">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}" />
                <TextBlock Text=":" Foreground="{StaticResource MutedText}" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Value}" FontWeight="Bold"
                           Foreground="{StaticResource AccentText}" FontFamily="{StaticResource MonoFont}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- プレビュー操作。
             WrapPanelだと、ウィンドウ幅や隠れているグループの有無で折り返し位置が変わり、
             同じ場所を押しているつもりで違うボタンを押すことになります。
             行を固定し、狭いときは折り返さずに横スクロールさせます。 -->
        <ScrollViewer DockPanel.Dock="Top" Margin="0,0,0,6"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- 1段目: 操作モードと倍率 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Border Style="{StaticResource ToolGroup}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Content="↖ 選択" GroupName="Tool" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsArrowTool, Mode=TwoWay}"
                               ToolTip="矢印。ドラッグもホイールも意味を変えません（既定）。" />
                  <RadioButton Content="✋ 移動" GroupName="Tool" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsHandTool, Mode=TwoWay}"
                               ToolTip="手のひら。ドラッグで表示位置を動かします。ホイールは通常のスクロールです。" />
                  <RadioButton Content="🔍 拡大鏡" GroupName="Tool" Style="{StaticResource ToolToggle}" Margin="0"
                               IsChecked="{Binding IsZoomTool, Mode=TwoWay}"
                               ToolTip="虫眼鏡。ホイールを回すだけで拡大縮小します（Ctrl不要）。カーソル下の画素は動きません。" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ToolGroup}" Margin="0">
                <StackPanel Orientation="Horizontal">
                  <Button Content="−" Width="32" MinWidth="32" Command="NavigationCommands.DecreaseZoom"
                          ToolTip="表示倍率を1段階下げます（Ctrl+−）。表示領域の中央は動きません。" />
                  <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4"
                          Background="White" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScaleText}" MinWidth="52" TextAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" />
                  </Border>
                  <Button Content="＋" Width="32" MinWidth="32" Command="NavigationCommands.IncreaseZoom"
                          ToolTip="表示倍率を1段階上げます（Ctrl++）。表示領域の中央は動きません。Ctrl+ホイールならカーソル位置が動きません。" />
                  <Button Content="等倍" Command="{Binding ActualSizeCommand}"
                          ToolTip="100%（1画素を1点で表示）に戻します（Ctrl+0）。" />
                  <Button Content="全体表示" Margin="0" Click="OnFitClick"
                          ToolTip="画像全体が入る倍率にして中央へ寄せます。" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 2段目: 読み方の設定と書き出し。
                 読み方（matrix / range / 成分 / 色差）を左、書き出しを右に横並びにします。
                 使えない条件のグループも Hidden で場所を確保し、位置を動かしません。 -->
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource ToolGroup}"
                      Visibility="{Binding IsYcbcrSelected, Converter={StaticResource BoolToHidden}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="matrix" VerticalAlignment="Center" Margin="2,0,4,0"
                             Foreground="{StaticResource MutedText}" />
                  <ComboBox ItemsSource="{Binding MatrixOptions}" SelectedItem="{Binding SelectedMatrix}"
                            Width="70" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="RGBへ戻すときの変換係数です。manifestと違う値にすると色相と明るさが変わります。" />
                  <TextBlock Text="range" VerticalAlignment="Center" Margin="0,0,4,0"
                             Foreground="{StaticResource MutedText}" />
                  <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"
                            Width="68" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="コード値の使用範囲です。manifestと違う値にすると黒浮きや白飛びが出ます。" />
                  <Button Content="戻す" Command="{Binding ResetInterpretationCommand}" Margin="0"
                          ToolTip="matrix・range・成分・色差の戻し方を、manifestに記録された条件へ戻します。" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ToolGroup}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="成分" VerticalAlignment="Center" Margin="2,0,6,0"
                             Foreground="{StaticResource MutedText}" />
                  <RadioButton Content="すべて" GroupName="Channel" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsAllChannels, Mode=TwoWay}"
                               ToolTip="3成分をまとめてRGBへ変換して表示します。" />
                  <RadioButton Content="{Binding FirstChannelLabel}" GroupName="Channel" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsFirstChannel, Mode=TwoWay}"
                               ToolTip="第1成分だけを濃淡で表示します。色変換は通しません。" />
                  <RadioButton Content="{Binding SecondChannelLabel}" GroupName="Channel" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsSecondChannel, Mode=TwoWay}"
                               ToolTip="第2成分だけを濃淡で表示します。4:2:0や4:2:2では、間引かれた粗さがそのまま見えます。" />
                  <RadioButton Content="{Binding ThirdChannelLabel}" GroupName="Channel" Style="{StaticResource ToolToggle}"
                               Margin="0" IsChecked="{Binding IsThirdChannel, Mode=TwoWay}"
                               ToolTip="第3成分だけを濃淡で表示します。" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ToolGroup}" Margin="0"
                      Visibility="{Binding HasSubsampledChroma, Converter={StaticResource BoolToHidden}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="色差" VerticalAlignment="Center" Margin="2,0,6,0"
                             Foreground="{StaticResource MutedText}" />
                  <RadioButton Content="最近傍" GroupName="Upsample" Style="{StaticResource ToolToggle}"
                               IsChecked="{Binding IsNearestUpsample, Mode=TwoWay}"
                               ToolTip="格納されている色差をそのまま複製します（生成側と同じ）。間引かれた粗さが四角として見えます。" />
                  <RadioButton Content="バイリニア" GroupName="Upsample" Style="{StaticResource ToolToggle}" Margin="0"
                               IsChecked="{Binding IsBilinearUpsample, Mode=TwoWay}"
                               ToolTip="隣り合う色差サンプルの間を線形に補間します。境界がなだらかになります。" />
                </StackPanel>
              </Border>

            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- キャンバス -->
        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <Grid>
            <ScrollViewer x:Name="PreviewScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource CheckerBrush}"
                          PreviewMouseWheel="OnPreviewWheel"
                          PreviewMouseLeftButtonDown="OnPreviewLeftButtonDown"
                          PreviewMouseLeftButtonUp="OnPreviewLeftButtonUp"
                          MouseMove="OnPreviewScrollMouseMove"
                          SizeChanged="OnScrollSizeChanged">
              <!-- 画像の外周に細い線を引きます。背景が暗いので、
                   黒いパターンだと画像の端が背景と見分けられなくなるためです。 -->
              <Border x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                      BorderBrush="#FF6E7480" BorderThickness="1">
              <Image x:Name="PreviewImageElement"
                     Source="{Binding PreviewImage}"
                     Width="{Binding ScaledWidth}" Height="{Binding ScaledHeight}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     RenderOptions.EdgeMode="Aliased"
                     MouseMove="OnPreviewMouseMove"
                     MouseLeave="OnPreviewMouseLeave"
                     PreviewMouseRightButtonDown="OnPreviewRightButtonDown">
                <Image.ContextMenu>
                  <!-- ContextMenu は視覚ツリーの外に出るため、DataContext を明示的に引き継ぎます。 -->
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource Self}}">
                    <!-- 各項目には「実際にコピーされる文字列」をそのまま並べます。
                         名前だけでは何が取れるのか分からないためです。 -->
                    <MenuItem Header="この画素をコピー" IsEnabled="False" />
                    <Separator />

                    <MenuItem Command="{Binding CopySampleCommand}" CommandParameter="hex"
                              ToolTip="変換後の表示色を #RRGGBB で取得します。matrixとrangeを適用し、8bitへ丸めた後の値です。">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="HEX" Width="96" />
                          <TextBlock Text="{Binding SampleHexText}" FontFamily="{StaticResource MonoFont}"
                                     Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding CopySampleCommand}" CommandParameter="rgb"
                              ToolTip="変換後の表示色を R, G, B の10進で取得します。8bitへ丸めた後の値です。">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="RGB 値" Width="96" />
                          <TextBlock Text="{Binding SampleRgbText}" FontFamily="{StaticResource MonoFont}"
                                     Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding CopySampleCommand}" CommandParameter="code"
                              ToolTip="RAWから読んだ生の値です。変換していません。10bitなら 0-1023 のまま取得します。4:2:0 / 4:2:2 の Cb・Cr は、その画素が共有している間引き後のサンプルです。">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="生コード値" Width="96" />
                          <TextBlock Text="{Binding SampleCodeText}" FontFamily="{StaticResource MonoFont}"
                                     Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Command="{Binding CopySampleCommand}" CommandParameter="xy"
                              ToolTip="画素の座標を x, y で取得します。左上が (0, 0) です。">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="座標" Width="96" />
                          <TextBlock Text="{Binding SamplePositionText}" FontFamily="{StaticResource MonoFont}"
                                     Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>

                    <Separator />

                    <MenuItem Command="{Binding CopySampleCommand}" CommandParameter="all"
                              ToolTip="座標・生コード値・変換後の色をまとめて1行で取得します。記事やテストコードへ貼るとき用です。">
                      <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="まとめて1行" Width="96" />
                          <TextBlock Text="{Binding SampleFullText}" FontFamily="{StaticResource MonoFont}"
                                     Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                  </ContextMenu>
                </Image.ContextMenu>
              </Image>
              </Border>
            </ScrollViewer>

            <!-- manifestと違う条件で見ているときの警告。キャンバスへ重ねて出します。
                 ツールバーの中に置くと、出たり消えたりするたびに枠の高さが変わってしまいます。 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8" Padding="10,6"
                    CornerRadius="4" Background="#F0FFF4E5" BorderBrush="#FFE0B77A" BorderThickness="1"
                    Visibility="{Binding IsInterpretationOverridden, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding OverrideWarning}" TextWrapping="Wrap" Foreground="#FF7A4E00" />
            </Border>

            <TextBlock Text="{Binding UnsupportedMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#FFE8E8E8" FontSize="13">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UnsupportedMessage}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource PanelBorder}" />

      <!-- 右: 生成条件とプレビューの作り方 -->
      <DockPanel Grid.Column="4" Margin="8">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource SectionHeader}"
                     Text="RAWに記録された生成条件" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="既定に戻す" Margin="0" Click="OnResetParameterViewClick"
                  ToolTip="列の表示と並び替えを、最初の状態へ戻します。" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="表示する列:" VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{StaticResource MutedText}" />
          <CheckBox x:Name="ShowNameColumn" Content="項目" IsChecked="True" Margin="0,0,12,0"
                    VerticalAlignment="Center" Checked="OnColumnToggled" Unchecked="OnColumnToggled"
                    ToolTip="日本語の項目名の列です。" />
          <CheckBox x:Name="ShowValueColumn" Content="値" IsChecked="True" Margin="0,0,12,0"
                    VerticalAlignment="Center" Checked="OnColumnToggled" Unchecked="OnColumnToggled"
                    ToolTip="manifestに記録されている値の列です。" />
          <!-- manifestキーは、CLIや生成器と突き合わせるとき以外は要らないので既定でオフです。 -->
          <CheckBox x:Name="ShowKeyColumn" Content="manifestキー" IsChecked="False"
                    VerticalAlignment="Center" Checked="OnColumnToggled" Unchecked="OnColumnToggled"
                    ToolTip="JSON上のキー名の列です。生成器やCLIの指定と突き合わせるときに使います。" />
        </StackPanel>

        <!-- 表は内容ぶんだけの高さにして上へ詰めます。
             引き伸ばすと、下の説明欄が画面の底へ追いやられて遠くなります。 -->
        <DataGrid x:Name="ParameterGrid" DockPanel.Dock="Top" MaxHeight="430"
                  ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="True"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  ToolTip="列見出しを押すと昇順・降順で並び替えられます。「既定に戻す」で元の並びへ戻せます。">
          <DataGrid.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFCFE4FA" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF11223A" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFE3ECF6" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF11223A" />
          </DataGrid.Resources>
          <DataGrid.Columns>
            <!-- 項目名の列は薄く塗って、値の列と見分けられるようにします。 -->
            <DataGridTextColumn x:Name="NameColumn" Header="項目" Binding="{Binding Name}" Width="Auto">
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell">
                  <Setter Property="Background" Value="{StaticResource RowHeaderFill}" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="6,2" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn x:Name="ValueColumn" Header="値" Binding="{Binding Value}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="ToolTip" Value="{Binding Value}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn x:Name="KeyColumn" Header="manifestキー" Binding="{Binding EnglishName}" Width="Auto">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                  <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- 高さを固定します。説明の行数で枠が伸び縮みすると、
             項目を選ぶたびに下のパネルまで動いてしまいます。 -->
        <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="10,8" Height="132"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="この項目の意味" FontWeight="Bold" Margin="0,0,0,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding ParameterHelp}" TextWrapping="Wrap" VerticalAlignment="Top" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- いま見えている絵がどう作られたか。RAWそのものではないことを明示します。 -->
        <!-- ここだけ他のパネルと色を変えます。
             「いま見えているものはRAWではない」という注意書きなので、
             他の情報と同じ見た目だと読み飛ばされます。 -->
        <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
                Background="#FFFFFAE8" BorderBrush="#FFE3C775" BorderThickness="2">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="⚠ 表示中の絵の作り方（RAWそのものではありません）"
                       FontWeight="Bold" Margin="0,0,0,6" Foreground="#FF8A5A00" TextWrapping="Wrap" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding PreviewRecipe}" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF4A3A12" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </DockPanel>

    </Grid>
  </DockPanel>
</Window>
